{
  "name": "somnuslabs-web-frontend",
  "version": "0.1.0",
  "description": "Somnus Labs company website (somnuslabs.com): product pages, blog, legal and SMS pages, and a mailing-list sign-up.",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prepare": "husky install",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@sendgrid/client": "^8.1.6",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "10.4.15",
    "next": "15.5.29",
    "postcss": "8.5.33",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "3.3.3",
    "typescript": "5.2.2"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "5.17.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.4.3",
    "@types/node": "20.6.0",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@types/testing-library__jest-dom": "5.14.5",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "8.49.0",
    "eslint-config-next": "15.5.29",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-testing-library": "^5.11.1",
    "eslint-plugin-unused-imports": "^3.0.0",
    "husky": "^8.0.3",
    "jest": "29.5.0",
    "jest-environment-jsdom": "29.5.0",
    "lint-staged": "^14.0.1",
    "prettier": "^2.8.8"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{html,css}": [
      "prettier --write"
    ]
  }
}
